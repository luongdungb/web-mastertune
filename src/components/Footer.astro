---
import Logo from './Logo.astro';
import site from '../data/site.json';
import brands from '../data/brands.json';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand-col">
      <Logo variant="stacked" height={110} />
      <p class="muted">{site.tagline}. Tư vấn cấu hình, đào tạo kỹ thuật viên và hệ thống đại lý lắp đặt trên toàn quốc.</p>
      <a class="btn btn-primary" href={site.zalo} target="_blank" rel="noopener">Nhắn Zalo tư vấn</a>
    </div>
    <div>
      <h2 class="col-title">Thương hiệu</h2>
      <ul>
        {brands.slice(0, 7).map((b) => <li><a href={`/thuong-hieu/${b.slug}`}>{b.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="col-title">Công cụ</h2>
      <ul>
        <li><a href="/ghep-he-thong">Ghép hệ thống</a></li>
        <li><a href="/cau-hinh-theo-xe">Cấu hình theo dòng xe</a></li>
        <li><a href="/tim-he-thong">Tìm hệ thống phù hợp</a></li>
        <li><a href="/so-sanh">So sánh sản phẩm</a></li>
        <li><a href="/dai-ly">Tìm đại lý</a></li>
        <li><a href="/bao-hanh">Tra cứu bảo hành</a></li>
      </ul>
    </div>
    <div>
      <h2 class="col-title">Liên hệ</h2>
      <ul class="contact">
        <li><a href={`tel:${site.hotlineTel}`} class="hotline">{site.hotline}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.addresses.map((a) => <li><span class="label">{a.label}</span>{a.text}</li>)}
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} MASTERTUNE. Sản phẩm chính hãng, bảo hành theo chính sách của từng thương hiệu.</p>
    <a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a>
  </div>
</footer>

<style>
  .site-footer { margin: var(--space-8) var(--frame) var(--frame); padding-top: var(--space-16); background: var(--surface); border-radius: var(--radius-l); }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.4fr; gap: var(--space-12); }
  .brand-col { display: grid; gap: var(--space-6); align-content: start; justify-items: start; }
  .brand-col p { max-width: 38ch; font-size: var(--t-sm); }
  .col-title { font-size: var(--t-xs); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-2); margin-bottom: var(--space-4); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); font-size: var(--t-sm); }
  li { color: var(--fg-2); }
  a { text-decoration: none; color: var(--fg-2); }
  a:hover { color: var(--fg); }
  .hotline { font-size: var(--t-xl); font-stretch: 104%; font-weight: 300; color: var(--fg); font-variant-numeric: tabular-nums; }
  .label { display: block; color: var(--fg); font-weight: 500; }
  .legal {
    display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap;
    margin-top: var(--space-16); padding-block: var(--space-6); border-top: 1px solid var(--line);
    font-size: var(--t-xs); color: var(--fg-2);
  }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } .brand-col { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
