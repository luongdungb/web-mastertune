---
import Base from '../layouts/Base.astro';
import CarSound3D from '../components/CarSound3D.astro';
import Spotlight from '../components/Spotlight.astro';
import dealers from '../data/dealers.json';
import products from '../data/products.json';
import brands from '../data/brands.json';
import categories from '../data/categories.json';
import site from '../data/site.json';

const bySlug = (s: string) => products.find((p) => p.slug === s)!;
const featured = [
  'amply-dsp-12-kenh-resolut-x12-dsp',
  'abyss-6-5h-2way-component-speaker',
  'loa-sub-hoi-dong-thung-steg-st10p-pro',
  'loa-canh-phan-tan-2-way-audiocircle-ml-c6-2',
].map(bySlug).filter(Boolean);
const brandName = Object.fromEntries(brands.map((b) => [b.slug, b.name]));

const catCover: Record<string, string> = {
  'loa-canh': 'loa-canh-phan-tan-2-way-audiocircle-ml-c6-2',
  'mid-treble': 'loa-mid-treble-steg-sff3',
  subwoofer: 'loa-sub-hoi-audiocircle-ml-s10',
  'sub-dien': 'loa-sub-dien-dls-acw10i',
  amply: 'amply-mono-dls-cci500',
  dsp: 'amply-dsp-12-kenh-resolut-x12-dsp',
};
const shownCats = categories.filter((c) => catCover[c.slug]);
const totalProducts = products.length;
const dealerCount = dealers.length;
const statProducts = ['loa-mid-treble-steg-sff1', 'amply-dsp-12-kenh-resolut-x12-dsp', 'loa-sub-dien-vinsub-vs-8-pro'].map(bySlug).filter(Boolean);
// the product in the hero video, with two close-ups for the callouts
const heroProduct = {
  slug: 'loa-mid-treble-steg-sff1',
  label: 'STEG SFF1',
  sub: 'Mid-treble Ø70 mm',
  thumb: '/images/g/loa-mid-treble-steg-sff1-1-t.webp',
  thumb2: '/images/g/loa-mid-treble-steg-sff1-3-t.webp',
};
---
<Base overlayHeader>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-card">
      <div class="hero-stage" data-hero-stage>
        <h1 id="hero-title" class="hero-title">
          <span class="w w1">MASTER</span>
          <span class="w w2">TUNE</span>
          <span class="sr-only">: âm thanh xe hơi hi-end, phân phối chính hãng</span>
        </h1>

        <figure class="subject" aria-hidden="true">
          <video autoplay muted loop playsinline preload="auto" poster="/video/hero-poster.webp" width="720" height="1280" data-hero-video>
            <source src="/video/hero.webm" type="video/webm" />
            <source src="/video/hero.mp4" type="video/mp4" />
          </video>
          <span class="dot" style="--x:74%;--y:44%" data-dot="a"></span>
          <span class="dot" style="--x:22%;--y:60%" data-dot="b"></span>
        </figure>

        <a class="callout c-a" href={`/san-pham/${heroProduct.slug}`} data-callout="a">
          <span class="c-text"><span>{heroProduct.label}</span><span>{heroProduct.sub}</span></span>
          <img src={heroProduct.thumb} alt="" width="120" height="96" decoding="async" />
          <span class="c-rule"></span>
        </a>
        <a class="callout c-b" href={`/san-pham/${heroProduct.slug}`} data-callout="b">
          <img src={heroProduct.thumb2} alt="" width="120" height="96" decoding="async" />
          <span class="c-text"><span>Mặt lưới nhôm CNC</span><span>Họa tiết Mandala</span></span>
          <span class="c-rule"></span>
        </a>
        <svg class="leaders" aria-hidden="true" data-leaders><line data-line="a" /><line data-line="b" /></svg>
      </div>

      <div class="panels">
        <div class="panel p-left">
          <div class="chips" aria-hidden="true">
            <span><svg viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span>
            <span><svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 4v16M12 4v16M19 4v16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="5" cy="9" r="2" fill="#f5f8fa" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="15" r="2" fill="#f5f8fa" stroke="currentColor" stroke-width="1.4"/><circle cx="19" cy="7" r="2" fill="#f5f8fa" stroke="currentColor" stroke-width="1.4"/></svg></span>
          </div>
          <p class="p-lead">Phân phối chính hãng {brands.length} thương hiệu âm thanh xe hơi từ Ý, Đức, Thụy Điển.</p>
          <a class="p-link" href="/thuong-hieu">Xem thương hiệu</a>
        </div>
        <div class="panel p-center">
          <a class="btn btn-primary cta" href="/ghep-he-thong">Ghép hệ thống của bạn</a>
          <p class="p-title">Ghép đúng cấu hình, lắp đúng kỹ thuật</p>
          <p class="p-small">Loa, amply, DSP hi-end. Chọn thiết bị, gửi cấu hình, nhận báo giá từ kỹ thuật viên.</p>
        </div>
        <div class="panel p-right">
          <p class="p-meta"><span class="star" aria-hidden="true">✦</span> {totalProducts} sản phẩm chính hãng</p>
          <div class="p-stat">
            <ul class="avatars" aria-hidden="true">
              {statProducts.map((p) => <li><img src={p.image} alt="" width="44" height="44" loading="lazy" /></li>)}
            </ul>
            <p><strong>{dealerCount}+</strong> <span>đại lý</span></p>
          </div>
          <p class="p-small">Lắp đặt và bảo hành tại đại lý chính hãng trên toàn quốc. <a href="/dai-ly">Tìm đại lý</a></p>
        </div>
      </div>
    </div>
  </section>

  <Spotlight />

  <!-- BRANDS -->
  <section class="brands" aria-label="Thương hiệu phân phối">
    <ul class="wrap brand-row">
      {brands.filter((b) => b.logo).map((b) => (
        <li><a href={`/thuong-hieu/${b.slug}`} title={b.name}><img src={b.logo!} alt={b.name} width="160" height="54" loading="lazy" /></a></li>
      ))}
    </ul>
  </section>

  <CarSound3D />

  <!-- CATEGORIES (studio) -->
  <section class="studio section" aria-labelledby="cat-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="cat-title" class="display">Thiết bị</h2>
      </div>
      <ul class="cat-grid">
        {shownCats.map((c) => {
          const cover = bySlug(catCover[c.slug]);
          return (
            <li>
              <a class="cat-card" href={`/san-pham?loai=${c.slug}`}>
                <img src={cover?.image} alt="" width="320" height="240" loading="lazy" decoding="async" />
                <div class="cat-meta">
                  <h3>{c.label}</h3>
                  <span class="count">{c.count}</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>

      <div class="featured">
        <h2 class="featured-title">Được chọn nhiều</h2>
        <ul class="prod-grid">
          {featured.map((p) => (
            <li>
              <a class="prod-card" href={`/san-pham/${p.slug}`}>
                <div class="prod-img"><img src={p.image} alt={p.name} width="400" height="400" loading="lazy" decoding="async" /></div>
                <p class="prod-brand">{brandName[p.brand]}</p>
                <h3>{p.name}</h3>
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn-ink" href="/san-pham">Xem toàn bộ {totalProducts} sản phẩm</a>
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="section tools" aria-labelledby="tools-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="tools-title" class="display">Bắt đầu cấu hình</h2>
      </div>
      <ol class="tool-list">
        <li>
          <a href="/tim-he-thong">
            <h3>Trả lời 4 câu hỏi</h3>
            <p class="muted">Nhận gợi ý cấu hình trong một phút.</p>
          </a>
        </li>
        <li>
          <a href="/ghep-he-thong">
            <h3>Tự ghép hệ thống</h3>
            <p class="muted">Chọn từng thiết bị, gửi để nhận báo giá.</p>
          </a>
        </li>
        <li>
          <a href="/cau-hinh-theo-xe">
            <h3>Theo dòng xe</h3>
            <p class="muted">Cấu hình gợi ý và xe cùng dòng đã lắp.</p>
          </a>
        </li>
        <li>
          <a href="/goi-am-thanh">
            <h3>Chọn gói dựng sẵn</h3>
            <p class="muted">Cấu hình đã được kỹ thuật viên phối sẵn.</p>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- SHOWCASE -->
  <section class="section showcase" aria-labelledby="show-title">
    <div class="wrap show-grid">
      <figure class="show-main">
        <img src="/images/s/news-emma-2025.webp" alt="Đội ngũ MASTERTUNE và các đại lý nâng cúp tại giải thi đấu âm thanh xe hơi EMMA Việt Nam 2025" width="1000" height="666" loading="lazy" decoding="async" />
      </figure>
      <div class="show-text">
        <h2 id="show-title" class="display">Kiểm chứng trên sân khấu thi đấu</h2>
        <p class="muted">EMMA Việt Nam 2025.</p>
        <div class="hero-cta">
          <a class="btn btn-light" href="/showcase">Xem showcase</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DEALERS -->
  <section class="studio section dealers" aria-labelledby="dealer-title">
    <div class="wrap dealer-grid">
      <div>
        <h2 id="dealer-title" class="display">Đại lý chính hãng</h2>
      </div>
      <div class="dealer-actions">
        <a class="dealer-card" href="/dai-ly"><h3>Tìm đại lý gần bạn</h3></a>
        <a class="dealer-card" href="/dai-ly#kiem-tra"><h3>Kiểm tra đại lý</h3></a>
        <a class="dealer-card" href="/bao-hanh"><h3>Tra cứu bảo hành</h3></a>
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="final" aria-labelledby="final-title">
    <div class="final-card">
      <div class="final-inner">
        <p class="eyebrow">Tư vấn miễn phí</p>
        <h2 id="final-title" class="display">Nói chuyện với kỹ thuật viên</h2>
        <div class="hero-cta">
          <a class="btn btn-primary" href={site.zalo} target="_blank" rel="noopener">Nhắn Zalo</a>
          <a class="btn btn-light" href={`tel:${site.hotlineTel}`}>Gọi {site.hotline}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO: mist card inset from the viewport, giant thin wordmark, the product in an arch window */
  .hero { padding: var(--frame); }
  .hero-card {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: max(680px, min(100svh - 2 * var(--frame), 940px));
    display: grid; grid-template-rows: 1fr auto;
    border-radius: var(--radius-l); background: var(--mist); color: var(--on-mist);
  }
  /* soft light falling across the card */
  .hero-card::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 55% at 72% 18%, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0) 70%),
      radial-gradient(50% 60% at 12% 85%, rgba(120, 146, 166, 0.35), rgba(120, 146, 166, 0) 70%),
      linear-gradient(115deg, rgba(255, 255, 255, 0) 30%, rgba(255, 255, 255, 0.18) 48%, rgba(255, 255, 255, 0) 62%);
  }
  .hero-stage { position: relative; min-height: 0; }
  .hero-title { display: contents; }
  .w {
    position: absolute; z-index: 1; line-height: 0.86;
    font-size: clamp(4rem, 0.5rem + 11.5vw, 11.5rem); font-weight: 200; font-stretch: 104%; letter-spacing: -0.035em;
    color: #fff; text-shadow: 0 2px 30px rgba(60, 86, 108, 0.18); white-space: nowrap;
  }
  .w1 { left: 7%; top: calc(var(--header-h) + 7%); }
  .w2 { right: 6%; top: 50%; z-index: 3; }

  .subject {
    position: absolute; z-index: 2; margin: 0; left: 50%; bottom: -14%;
    width: clamp(240px, 27vw, 420px); aspect-ratio: 9 / 14; transform: translateX(-50%);
    border-radius: 999px 999px 40px 40px;
    box-shadow: 0 40px 80px -20px rgba(28, 46, 62, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.35);
  }
  .subject video { width: 100%; height: 100%; object-fit: cover; object-position: 50% 48%; border-radius: inherit; background: #050608; }
  .dot {
    position: absolute; left: var(--x); top: var(--y); width: 26px; height: 26px; margin: -13px 0 0 -13px;
    border-radius: 50%; border: 1.5px solid rgba(255, 255, 255, 0.95); background: rgba(255, 255, 255, 0.12);
  }
  .dot::after { content: ''; position: absolute; inset: 7px; border-radius: 50%; background: #fff; }

  .callout {
    position: absolute; z-index: 4; display: grid; grid-template-columns: auto auto; align-items: center; gap: var(--space-4);
    text-decoration: none; color: var(--on-mist); padding-bottom: var(--space-3);
  }
  .callout img {
    width: clamp(96px, 8vw, 124px); height: auto; aspect-ratio: 5 / 4; object-fit: cover; border-radius: 14px;
    background: rgba(255, 255, 255, 0.18); box-shadow: 0 10px 30px rgba(28, 46, 62, 0.25), inset 0 0 0 1px rgba(255, 255, 255, 0.4);
    transition: transform 260ms var(--ease-out);
  }
  .callout:hover img { transform: translateY(-3px); }
  .c-text { display: grid; font-size: var(--t-xs); letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.45; white-space: nowrap; }
  .c-text span:first-child { font-weight: 600; }
  .c-rule { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; border-radius: 2px; background: rgba(255, 255, 255, 0.9); }
  .c-a { right: 6%; top: calc(var(--header-h) + 9%); }
  .c-a .c-text { text-align: right; }
  .c-b { left: 6%; top: 58%; }
  .leaders { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 3; overflow: visible; }
  .leaders line { stroke: rgba(255, 255, 255, 0.85); stroke-width: 1; }

  /* bottom panels with slanted cut-outs: each panel's shape is a skewed, rounded pseudo-element;
     the card clips whatever sticks out at the sides */
  .panels {
    position: relative; z-index: 5; display: grid; grid-template-columns: 1fr 1.05fr 1fr;
    column-gap: clamp(28px, 2.6vw, 40px); min-height: clamp(170px, 21vh, 210px); color: var(--fg);
  }
  .panel { position: relative; padding: var(--space-6) clamp(1.25rem, 2.6vw, 2.5rem); display: grid; align-content: start; gap: var(--space-3); }
  .panel::before, .panel::after { content: ''; position: absolute; top: 0; bottom: -40px; z-index: -1; background: var(--bg); border-radius: var(--radius-l) var(--radius-l) 0 0; }
  /* outer panels: straight outer edge (pushed off the card), inner edge leans in toward the top */
  .p-left::before { left: -80px; right: 0; transform-origin: 100% 100%; transform: skewX(12deg); }
  .p-right::before { right: -80px; left: 0; transform-origin: 0 100%; transform: skewX(-12deg); }
  /* centre: wider at the top. Two full-width copies skewed in opposite directions; their union
     has both edges leaning out and no gap at any width */
  .p-center::before { left: 0; right: 0; transform-origin: 0 100%; transform: skewX(12deg); }
  .p-center::after { right: 0; left: 0; transform-origin: 100% 100%; transform: skewX(-12deg); }
  .p-left::after, .p-right::after { display: none; }
  .p-center { text-align: center; justify-items: center; padding-top: calc(var(--space-8) + 8px); }
  .cta { position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); }
  .p-title { font-size: clamp(1.25rem, 0.9rem + 1vw, 1.75rem); font-weight: 400; font-stretch: 104%; line-height: 1.2; letter-spacing: -0.01em; text-wrap: balance; }
  .p-small { font-size: var(--t-xs); color: var(--fg-2); line-height: 1.6; max-width: 46ch; }
  .p-small a { color: var(--fg); font-weight: 600; }
  .chips { display: flex; gap: var(--space-2); }
  .chips span { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); box-shadow: var(--shadow-soft); color: var(--fg); }
  .p-lead { font-size: var(--t-base); font-weight: 500; line-height: 1.4; max-width: 30ch; }
  .p-link { font-size: var(--t-sm); font-weight: 600; justify-self: start; text-underline-offset: 4px; }
  .p-meta { font-size: var(--t-sm); font-weight: 500; }
  .star { color: var(--signal); }
  .p-stat { display: flex; align-items: center; gap: var(--space-4); }
  .p-stat p { display: flex; align-items: baseline; gap: var(--space-2); }
  .p-stat strong { font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem); font-weight: 300; font-stretch: 104%; letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }
  .p-stat span { font-size: var(--t-sm); color: var(--fg-2); }
  .avatars { list-style: none; margin: 0; padding: 0; display: flex; }
  .avatars li { width: 44px; height: 44px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 3px var(--bg); display: grid; place-items: center; overflow: hidden; }
  .avatars li + li { margin-left: -10px; }
  .avatars img { width: 86%; height: 86%; object-fit: contain; }

  /* page-load: words rise, the arch settles, callouts arrive last */
  @media (prefers-reduced-motion: no-preference) {
    .w, .callout, .leaders, .panels { animation: rise 1000ms var(--ease-out) both; }
    .w2 { animation-delay: 120ms; }
    .subject { animation: settle 1400ms var(--ease-out) both; }
    .callout, .leaders { animation-delay: 700ms; animation-name: fade; }
    .panels { animation-delay: 240ms; }
    @keyframes rise { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
    @keyframes settle { from { transform: translate(-50%, 6%) scale(0.96); opacity: 0; } to { transform: translateX(-50%); opacity: 1; } }
    @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  }

  @media (max-width: 1100px) {
    .c-b { top: 62%; }
    .callout img { width: 88px; }
  }
  /* phones / small tablets: stacked, no slanted cut-outs, callouts hidden */
  @media (max-width: 860px) {
    .hero-card { min-height: 0; grid-template-rows: auto auto; }
    .hero-stage { height: clamp(520px, 135vw, 700px); }
    .w { font-size: clamp(3.25rem, 1rem + 13vw, 6.5rem); }
    .w1 { left: 5%; top: calc(var(--header-h) + 3%); }
    .w2 { right: 5%; top: auto; bottom: 20%; }
    .subject { width: min(58%, 300px); bottom: -6%; }
    .callout, .leaders, .dot { display: none; }
    .panels { grid-template-columns: 1fr; row-gap: var(--space-3); padding: var(--space-3); background: var(--bg); }
    .panel { background: var(--surface); border-radius: var(--radius-m); padding: var(--space-6); }
    .panel::before, .panel::after { display: none; }
    .p-center { order: -1; padding-top: var(--space-6); }
    .cta { position: static; transform: none; order: 3; }
  }

  /* BRANDS */
  .brands { border-top: 1px solid var(--line); }
  .brand-row { list-style: none; margin: 0 auto; padding: var(--space-8) 0; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-8); }
  .brand-row a { display: block; padding: var(--space-2); }
  .brand-row img { height: 40px; width: auto; max-width: 140px; object-fit: contain; filter: brightness(0); opacity: 0.42; transition: opacity 200ms; }
  .brand-row a:hover img { opacity: 0.9; }

  /* STUDIO: categories + featured */
  .split { grid-template-columns: 1fr 1fr; align-items: end; }
  .split h2 { max-width: 14ch; }
  .split p { font-size: var(--t-base); max-width: 44ch; justify-self: end; }
  .cat-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .cat-card {
    display: grid; grid-template-columns: 132px 1fr; gap: var(--space-4); align-items: center;
    background: var(--studio-card); border: 1px solid var(--studio-line); border-radius: var(--radius-m);
    padding: var(--space-4); text-decoration: none; height: 100%;
    transition: border-color 180ms;
  }
  .cat-card:hover { border-color: var(--ink); }
  .cat-card img { width: 132px; height: 112px; object-fit: contain; }
  .cat-meta { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
  .cat-meta h3 { font-size: var(--t-lg); font-stretch: 104%; font-weight: 400; }
    .count { font-size: var(--t-sm); color: var(--graphite); font-variant-numeric: tabular-nums; }

  .featured { margin-top: var(--space-24); display: grid; gap: var(--space-8); justify-items: start; }
  .featured-title { font-size: var(--t-xl); font-stretch: 104%; font-weight: 400; }
  .prod-grid { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .prod-card { display: grid; gap: var(--space-2); text-decoration: none; }
  .prod-img { background: var(--studio-card); border-radius: var(--radius-m); aspect-ratio: 1; display: grid; place-items: center; padding: var(--space-6); border: 1px solid var(--studio-line); transition: border-color 180ms; }
  .prod-card:hover .prod-img { border-color: var(--ink); }
  .prod-img img { width: 100%; height: 100%; object-fit: contain; }
  .prod-brand { font-size: var(--t-xs); color: var(--graphite); font-weight: 600; margin-top: var(--space-2); }
  .prod-card h3 { font-size: var(--t-base); font-weight: 600; line-height: 1.3; }
  .prod-specs { margin: var(--space-1) 0 0; display: grid; gap: 2px; font-size: var(--t-xs); }
  .prod-specs div { display: flex; justify-content: space-between; gap: var(--space-3); border-top: 1px solid var(--studio-line); padding-top: 4px; }
  .prod-specs dt { color: var(--graphite); }
  .prod-specs dd { margin: 0; text-align: right; font-weight: 500; }

  /* TOOLS — a real sequence: quiz -> build -> packages */
  .tool-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); counter-reset: tool; }
  .tool-list li { counter-increment: tool; }
  .tool-list a {
    display: grid; gap: var(--space-3); padding: var(--space-6); text-decoration: none; height: 100%; align-content: start;
    background: var(--surface); border-radius: var(--radius-m); box-shadow: var(--shadow-soft);
    transition: box-shadow 220ms var(--ease-out), transform 220ms var(--ease-out);
  }
  .tool-list a::before {
    content: counter(tool, decimal-leading-zero); width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    background: var(--mist); color: #fff; font-size: var(--t-xs); font-weight: 600; margin-bottom: var(--space-4);
  }
  .tool-list a:hover { box-shadow: var(--shadow-lift); transform: translateY(-2px); }
  .tool-list h3 { font-size: var(--t-xl); font-stretch: 104%; font-weight: 400; }
  .tool-list p { line-height: 1.55; font-size: var(--t-sm); }

  /* SHOWCASE */
  .showcase { border-top: 1px solid var(--line); }
  .show-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; }
