---
// Landing: one full-screen space with the product film. "Enter Portal" opens the website (/trang-chu).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import products from '../data/products.json';
import brands from '../data/brands.json';
import dealers from '../data/dealers.json';

const links = [
  { href: '/san-pham', label: 'Sản phẩm' },
  { href: '/thuong-hieu', label: 'Thương hiệu' },
  { href: '/dai-ly', label: 'Đại lý' },
];
---
<Base bare description={`MASTERTUNE: âm thanh xe hơi hi-end, phân phối chính hãng ${brands.length} thương hiệu. Loa, amply, DSP từ Ý, Đức, Thụy Điển. ${dealers.length} đại lý lắp đặt trên toàn quốc.`}>
  <link slot="head" rel="prefetch" href="/trang-chu" />
  <div class="portal" data-portal>
    <!-- the film: portrait clips sit centred and melt into the black; a landscape clip fills the screen -->
    <div class="media" aria-hidden="true">
      <video autoplay muted loop playsinline preload="auto" poster="/video/hero-poster.webp" data-film>
        <source src="/video/hero.webm" type="video/webm" />
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="shade" aria-hidden="true"></div>

    <!-- instrument lines -->
    <div class="lines" aria-hidden="true">
      <span class="ring"></span>
      <span class="h"></span>
      <span class="cross c-l"></span>
      <span class="cross c-r"></span>
      <span class="cross c-tl"></span>
      <span class="cross c-tr"></span>
      <span class="cross c-bl"></span>
      <span class="cross c-br"></span>
    </div>

    <header class="top">
      <a class="brand" href="/trang-chu" aria-label="MASTERTUNE — vào website"><Logo height={38} /></a>
      <span class="cross mid" aria-hidden="true"></span>
      <nav class="quick" aria-label="Đi nhanh">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </header>

    <div class="title">
      <h1>Âm thanh xe hơi <span>hi-end</span></h1>
      <p class="sub">Phân phối chính hãng · {brands.length} thương hiệu · Ý, Đức, Thụy Điển</p>
    </div>

    <ul class="readout left" aria-label="Sản phẩm trong phim">
      <li><span>STEG SFF1</span></li>
      <li><span>Mid-treble Ø70 mm</span></li>
      <li><span>165 Hz – 15 kHz</span></li>
    </ul>
    <ul class="readout right" aria-label="MASTERTUNE">
      <li><span>{products.length} sản phẩm</span></li>
      <li><span>{dealers.length} đại lý</span></li>
      <li><span>Bảo hành toàn quốc</span></li>
    </ul>

    <div class="enter">
      <a class="enter-btn" href="/trang-chu" data-enter>
        <span>Enter Portal</span>
        <span class="chev" aria-hidden="true">»</span>
      </a>
      <p class="hint">hoặc nhấn <kbd>Enter</kbd></p>
    </div>
  </div>
</Base>

<style>
  .portal {
    position: relative; height: 100svh; min-height: 560px; overflow: hidden; isolation: isolate;
    background: #000; color: var(--fg);
    display: grid; grid-template-rows: auto 1fr auto; padding: var(--space-6) clamp(1.25rem, 3vw, 2.5rem) var(--space-8);
  }

  /* film */
  .media { position: absolute; inset: 0; z-index: -3; display: grid; place-items: center; }
  .media video {
    height: 100%; width: auto; max-width: none; aspect-ratio: 9 / 16; object-fit: cover;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 76%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 76%, transparent 100%);
  }
  /* landscape clip (set by the script from the file itself): full bleed */
  .portal.wide .media video { width: 100%; height: 100%; aspect-ratio: auto; -webkit-mask-image: none; mask-image: none; }
  .shade {
    position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background:
      radial-gradient(70% 60% at 50% 55%, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.65) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 65%, rgba(0, 0, 0, 0.8) 100%);
  }

  /* instrument lines: a ring, a horizon, crosshair marks */
  .lines { position: absolute; inset: 0; z-index: -1; pointer-events: none; --r: min(46vmin, 440px); }
  .ring { position: absolute; left: 50%; top: 54%; width: calc(var(--r) * 2); height: calc(var(--r) * 2); transform: translate(-50%, -50%); border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 50%; }
  .h { position: absolute; left: 0; right: 0; top: 54%; height: 1px; background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.1) 15%, rgba(255, 255, 255, 0.1) 85%, rgba(255, 255, 255, 0)); }
  .lines .cross { margin: -7px 0 0 -7px; }
  .c-l { left: calc(50% - var(--r)); top: 54%; }
  .c-r { left: calc(50% + var(--r)); top: 54%; }
  .c-tl { left: 3%; top: 16%; } .c-tr { left: 97%; top: 16%; }
  .c-bl { left: 3%; top: 86%; } .c-br { left: 97%; top: 86%; }

  /* top bar */
  .top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .brand { justify-self: start; text-decoration: none; }
  .top .mid { position: relative; width: 22px; height: 22px; }
  .top .mid::before { left: 10px; height: 22px; background: #fff; }
  .top .mid::after { top: 10px; width: 22px; background: #fff; }
  .quick { justify-self: end; display: flex; gap: clamp(1rem, 2.4vw, 2.25rem); }
  .quick a { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; color: var(--fg-2); position: relative; padding: var(--space-2) 0 var(--space-2) 14px; transition: color 160ms; }
  .quick a::before { content: '+'; position: absolute; left: 0; top: 2px; font-size: 0.7rem; color: var(--fg-2); }
  .quick a:hover { color: var(--fg); }

  /* headline over the top of the product, like a title card */
  .title { align-self: start; justify-self: center; text-align: center; margin-top: clamp(1.5rem, 6vh, 4rem); display: grid; gap: var(--space-4); justify-items: center; }
  h1 {
    font-size: clamp(2.75rem, 1rem + 7vw, 7.5rem); font-weight: 800; line-height: 0.95; letter-spacing: -0.02em;
    text-transform: uppercase; text-wrap: balance; max-width: 14ch;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.6);
  }
  h1 span { display: block; color: transparent; -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.92); }
  .sub { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-2); }

  /* readouts */
  .readout { position: absolute; bottom: clamp(6.5rem, 14vh, 8.5rem); list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg); }
  .readout li::before { content: '[// '; color: var(--signal); }
  .readout li::after { content: ']'; color: var(--signal); }
  .readout.left { left: clamp(1.25rem, 3vw, 2.5rem); }
  .readout.right { right: clamp(1.25rem, 3vw, 2.5rem); text-align: right; }

  /* enter */
  .enter { justify-self: center; display: grid; justify-items: center; gap: var(--space-3); }
  .enter-btn {
    display: inline-flex; align-items: stretch; gap: 0; text-decoration: none;
    background: var(--signal); color: var(--signal-ink); border-radius: var(--radius-s); padding: 4px;
    box-shadow: 0 0 0 1px rgba(214, 245, 184, 0.25), 0 10px 40px rgba(214, 245, 184, 0.18);
    transition: box-shadow 240ms var(--ease-out), transform 240ms var(--ease-out);
  }
  .enter-btn > span:first-child { display: grid; place-items: center; padding: 0 var(--space-6); font-family: var(--mono); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; min-height: 48px; }
  .chev { display: grid; place-items: center; width: 44px; border-radius: 4px; background: var(--signal-ink); color: var(--signal); font-size: 1.2rem; transition: transform 240ms var(--ease-out); }
  .enter-btn:hover { box-shadow: 0 0 0 1px rgba(214, 245, 184, 0.5), 0 14px 50px rgba(214, 245, 184, 0.3); transform: translateY(-1px); }
  .enter-btn:hover .chev { transform: translateX(2px); }
  .hint { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-2); }
  kbd { font-family: inherit; border: 1px solid var(--line); border-radius: 4px; padding: 1px 6px; color: var(--fg); }

  /* entrance + exit */
  @media (prefers-reduced-motion: no-preference) {
    .media { animation: film 1800ms var(--ease-out) both; }
    .title, .readout, .enter, .top { animation: rise 1000ms var(--ease-out) both; }
    .title { animation-delay: 200ms; }
    .readout { animation-delay: 500ms; }
    .enter { animation-delay: 700ms; }
    .ring { animation: ring 1600ms var(--ease-out) both 200ms; }
    @keyframes film { from { opacity: 0; transform: scale(1.06); } to { opacity: 1; transform: none; } }
    @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @keyframes ring { from { opacity: 0; transform: translate(-50%, -50%) scale(0.92); } to { opacity: 1; transform: translate(-50%, -50%); } }
    .portal.leaving > * { transition: opacity 420ms var(--ease-out), transform 420ms var(--ease-out); opacity: 0; }
    .portal.leaving .media { transform: scale(1.08); }
  }

  @media (max-width: 760px) {
    .portal { padding: var(--space-4) var(--space-4) var(--space-6); }
    .quick { display: none; }
    .top { grid-template-columns: 1fr auto; }
    .top .mid { justify-self: end; }
    /* a portrait film already fills a phone */
    .media video { width: 100%; height: 100%; -webkit-mask-image: none; mask-image: none; }
    .readout { bottom: 8.5rem; font-size: 0.6875rem; }
    .readout.right, .hint { display: none; }
    .lines .c-tl, .lines .c-tr, .lines .c-bl, .lines .c-br { display: none; }
  }
</style>

<script>
  const portal = document.querySelector<HTMLElement>('[data-portal]')!;
  const film = portal.querySelector<HTMLVideoElement>('[data-film]')!;
  const markWide = () => portal.classList.toggle('wide', film.videoWidth > film.videoHeight);
  film.addEventListener('loadedmetadata', markWide);
  if (film.readyState >= 1) markWide();
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) film.pause();

  const enter = (e?: Event) => {
    e?.preventDefault();
    if (portal.classList.contains('leaving')) return;
    const go = () => location.assign('/trang-chu');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return go();
    portal.classList.add('leaving');
    setTimeout(go, 400);
  };
  portal.querySelector('[data-enter]')!.addEventListener('click', enter);
  window.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || e.defaultPrevented) return;
    const t = e.target as HTMLElement;
    if (t.closest('a, button, input, textarea, select')) return; // focused links handle Enter themselves
    enter(e);
  });
  // coming back with the browser's back button: show the portal again
  window.addEventListener('pageshow', (e) => { if (e.persisted) portal.classList.remove('leaving'); });
</script>
