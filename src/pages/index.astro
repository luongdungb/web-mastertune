---
// Landing: one full-screen space with the product film. "Enter Portal" opens the website (/trang-chu).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import products from '../data/products.json';
import brands from '../data/brands.json';
import dealers from '../data/dealers.json';

const links = [
  { href: '/san-pham', label: 'Sản phẩm' },
  { href: '/thuong-hieu', label: 'Thương hiệu' },
  { href: '/dai-ly', label: 'Đại lý' },
];
---
<Base bare description={`MASTERTUNE: âm thanh xe hơi hi-end, phân phối chính hãng ${brands.length} thương hiệu. Loa, amply, DSP từ Ý, Đức, Thụy Điển. ${dealers.length} đại lý lắp đặt trên toàn quốc.`}>
  <link slot="head" rel="prefetch" href="/trang-chu" />
  <div class="portal" data-portal>
    <!-- the film: portrait clips sit centred and melt into the black; a landscape clip fills the screen -->
    <div class="media" aria-hidden="true">
      <!-- phones: a still photo only (the film is never downloaded). Computers: the film's first frame
           sits here until the film, attached by the script below, starts playing on top of it. -->
      <picture>
        <source media="(min-width: 761px)" srcset="/video/hero-poster.webp" width="720" height="1280" />
        <img class="still" src="/video/hero-mobile.webp" width="893" height="1600" alt="" fetchpriority="high" decoding="async" />
      </picture>
      <!-- H.264 first: iPhones and in-app browsers (Zalo, Messenger) may pick WebM and then not play it -->
      <video autoplay muted loop playsinline webkit-playsinline disablepictureinpicture preload="auto" data-film></video>
    </div>
    <button class="film-btn" type="button" aria-pressed="false" data-film-btn>
      <span class="sr-only" data-film-label>Tạm dừng video nền</span>
      <svg class="i-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2h2v8H3zM7 2h2v8H7z" fill="currentColor" /></svg>
      <svg class="i-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" fill="currentColor" /></svg>
    </button>
    <div class="shade" aria-hidden="true"></div>

    <!-- instrument lines -->
    <div class="lines" aria-hidden="true">
      <span class="ring"></span>
      <span class="h"></span>
      <span class="cross c-l"></span>
      <span class="cross c-r"></span>
      <span class="cross c-tl"></span>
      <span class="cross c-tr"></span>
      <span class="cross c-bl"></span>
      <span class="cross c-br"></span>
    </div>

    <header class="top">
      <a class="brand" href="/trang-chu" aria-label="MASTERTUNE — vào website"><Logo height={38} /></a>
      <span class="cross mid" aria-hidden="true"></span>
      <nav class="quick" aria-label="Đi nhanh">
        {links.map((l) => <a href={l.href}><span>{l.label}</span><span class="q-chev" aria-hidden="true">›</span></a>)}
      </nav>
    </header>

    <div class="title">
      <h1><span class="name">MASTERTUNE</span> <span class="tagline">Âm thanh xe hơi cao cấp</span></h1>
    </div>

    <ul class="readout left" aria-label="Sản phẩm trong phim">
      <li><span>STEG SFF1</span></li>
      <li><span>Mid-treble Ø70 mm</span></li>
      <li><span>165 Hz – 15 kHz</span></li>
    </ul>
    <ul class="readout right" aria-label="MASTERTUNE">
      <li><span>{products.length} sản phẩm</span></li>
      <li><span>{dealers.length} đại lý</span></li>
      <li><span>Bảo hành toàn quốc</span></li>
    </ul>

    <div class="enter">
      <a class="enter-btn" href="/trang-chu" data-enter>
        <span>Enter Portal</span>
        <span class="chev" aria-hidden="true">»</span>
      </a>
      <p class="hint">hoặc nhấn <kbd>Enter</kbd></p>
    </div>
  </div>
</Base>

<style>
  .portal {
    position: relative; height: 100svh; min-height: 560px; overflow: hidden; isolation: isolate;
    background: #000; color: var(--fg);
    display: grid; grid-template-rows: auto 1fr auto; padding: var(--space-6) clamp(1.25rem, 3vw, 2.5rem) var(--space-8);
  }

  /* film */
  /* one fixed cell the size of the screen, so the film / still take 100% of its height */
  .media { position: absolute; inset: 0; z-index: -3; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center; overflow: hidden; }
  .media picture { display: contents; }
  /* still and film share one cell, the film on top */
  .media video, .media .still { grid-area: 1 / 1; }
  .media video, .media .still {
    height: 100%; width: auto; max-width: none; aspect-ratio: 9 / 16; object-fit: cover;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 76%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 76%, transparent 100%);
  }
  /* small pause / play for the background film */
  .film-btn {
    position: absolute; z-index: 2; right: clamp(1.25rem, 3vw, 2.5rem); bottom: clamp(1.75rem, 4vh, 2.5rem);
    display: grid; place-items: center; width: 36px; height: 36px; padding: 0; cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.18); border-radius: var(--radius-s);
    background: rgba(11, 12, 14, 0.45); color: var(--fg-2);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    transition: color 180ms, border-color 180ms;
  }
  .film-btn:hover { color: var(--fg); border-color: rgba(255, 255, 255, 0.4); }
  .film-btn .i-play, .film-btn[aria-pressed='true'] .i-pause { display: none; }
  .film-btn[aria-pressed='true'] .i-play { display: block; }
  /* landscape clip (set by the script from the file itself): full bleed */
  .portal.wide .media video, .portal.wide .media .still { width: 100%; height: 100%; aspect-ratio: auto; -webkit-mask-image: none; mask-image: none; }
  .shade {
    position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background:
      radial-gradient(70% 60% at 50% 55%, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.65) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 65%, rgba(0, 0, 0, 0.8) 100%);
  }

  /* instrument lines: a ring, a horizon, crosshair marks */
  .lines { position: absolute; inset: 0; z-index: -1; pointer-events: none; --r: min(46vmin, 440px); }
  .ring { position: absolute; left: 50%; top: 54%; width: calc(var(--r) * 2); height: calc(var(--r) * 2); transform: translate(-50%, -50%); border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 50%; }
  .h { position: absolute; left: 0; right: 0; top: 54%; height: 1px; background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.1) 15%, rgba(255, 255, 255, 0.1) 85%, rgba(255, 255, 255, 0)); }
  .lines .cross { margin: -7px 0 0 -7px; }
  .c-l { left: calc(50% - var(--r)); top: 54%; }
  .c-r { left: calc(50% + var(--r)); top: 54%; }
  .c-tl { left: 3%; top: 16%; } .c-tr { left: 97%; top: 16%; }
  .c-bl { left: 3%; top: 86%; } .c-br { left: 97%; top: 86%; }

  /* top bar */
  .top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .brand { justify-self: start; text-decoration: none; }
  .top .mid { position: relative; width: 22px; height: 22px; }
  .top .mid::before { left: 10px; height: 22px; background: #fff; }
  .top .mid::after { top: 10px; width: 22px; background: #fff; }
  /* small versions of the Enter Portal button: chrome frame, dark arrow block */
  .quick { justify-self: end; display: flex; gap: var(--space-3); }
  .quick a {
    display: inline-flex; align-items: stretch; padding: 3px; border-radius: var(--radius-s); text-decoration: none;
    background: var(--chrome); color: var(--signal-ink);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 0 0 1px rgba(201, 206, 214, 0.25), 0 6px 24px rgba(201, 206, 214, 0.12);
    transition: box-shadow 240ms var(--ease-out), transform 240ms var(--ease-out);
  }
  .quick a > span:first-child { display: grid; place-items: center; padding: 0 var(--space-3); min-height: 32px; font-family: var(--mono); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; }
  .q-chev { display: grid; place-items: center; width: 28px; border-radius: 4px; background: var(--signal-ink); color: #fff; font-size: 1rem; transition: transform 240ms var(--ease-out); }
  .quick a:hover { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 0 0 1px rgba(201, 206, 214, 0.5), 0 10px 30px rgba(201, 206, 214, 0.22); transform: translateY(-1px); }
  .quick a:hover .q-chev { transform: translateX(2px); }

  /* headline over the top of the product, like a title card */
  .title { align-self: start; justify-self: center; text-align: center; margin-top: clamp(1.5rem, 6vh, 4rem); display: grid; gap: var(--space-4); justify-items: center; }
  h1 { display: grid; justify-items: center; gap: clamp(0.5rem, 1.6vh, 1.1rem); filter: drop-shadow(0 6px 30px rgba(0, 0, 0, 0.7)); }
  /* the name in polished chrome, like the logo */
  .name {
    display: block; font-size: clamp(2.6rem, 0.6rem + 8.2vw, 8.25rem); font-weight: 800; line-height: 0.92; letter-spacing: -0.01em;
    background: linear-gradient(180deg, #ffffff 0%, #e3e6ea 44%, #9aa2ac 52%, #d4d8dd 78%, #f4f5f7 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .tagline { display: block; font-size: clamp(1.1rem, 0.6rem + 1.8vw, 2rem); font-weight: 300; letter-spacing: 0.04em; line-height: 1.2; color: var(--fg); }

  /* readouts */
  .readout { position: absolute; bottom: clamp(6.5rem, 14vh, 8.5rem); list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg); }
  .readout li::before { content: '[// '; color: var(--signal); }
  .readout li::after { content: ']'; color: var(--signal); }
  .readout.left { left: clamp(1.25rem, 3vw, 2.5rem); }
  .readout.right { right: clamp(1.25rem, 3vw, 2.5rem); text-align: right; }

  /* enter */
  .enter { justify-self: center; display: grid; justify-items: center; gap: var(--space-3); }
  .enter-btn {
    display: inline-flex; align-items: stretch; gap: 0; text-decoration: none;
    background: var(--chrome); color: var(--signal-ink); border-radius: var(--radius-s); padding: 4px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 0 0 1px rgba(201, 206, 214, 0.25), 0 10px 40px rgba(201, 206, 214, 0.16);
    transition: box-shadow 240ms var(--ease-out), transform 240ms var(--ease-out);
  }
  .enter-btn > span:first-child { display: grid; place-items: center; padding: 0 var(--space-6); font-family: var(--mono); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; min-height: 48px; }
  .chev { display: grid; place-items: center; width: 44px; border-radius: 4px; background: var(--signal-ink); color: #fff; font-size: 1.2rem; transition: transform 240ms var(--ease-out); }
  .enter-btn:hover { box-shadow: 0 0 0 1px rgba(201, 206, 214, 0.5), 0 14px 50px rgba(201, 206, 214, 0.3); transform: translateY(-1px); }
  .enter-btn:hover .chev { transform: translateX(2px); }
  .hint { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-2); }
  kbd { font-family: inherit; border: 1px solid var(--line); border-radius: 4px; padding: 1px 6px; color: var(--fg); }

  /* entrance + exit */
  @media (prefers-reduced-motion: no-preference) {
    .media { animation: film 1800ms var(--ease-out) both; }
    .title, .readout, .enter, .top { animation: rise 1000ms var(--ease-out) both; }
    .title { animation-delay: 200ms; }
    .readout { animation-delay: 500ms; }
    .enter { animation-delay: 700ms; }
    .ring { animation: ring 1600ms var(--ease-out) both 200ms; }
    @keyframes film { from { opacity: 0; transform: scale(1.06); } to { opacity: 1; transform: none; } }
    @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @keyframes ring { from { opacity: 0; transform: translate(-50%, -50%) scale(0.92); } to { opacity: 1; transform: translate(-50%, -50%); } }
    .portal.leaving > * { transition: opacity 420ms var(--ease-out), transform 420ms var(--ease-out); opacity: 0; }
    .portal.leaving .media { transform: scale(1.08); }
  }

  @media (max-width: 760px) {
    .portal { padding: var(--space-4) var(--space-4) var(--space-6); }
    .quick { display: none; }
    .top { grid-template-columns: 1fr auto; }
    .top .mid { justify-self: end; }
    /* phones show the still photo, full screen; no film */
    .media video, .film-btn { display: none; }
    .media .still { width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; object-position: 50% 50%; -webkit-mask-image: none; mask-image: none; }
    .readout { bottom: 8.5rem; font-size: 0.6875rem; }
    .readout.right, .hint { display: none; }
    .lines .c-tl, .lines .c-tr, .lines .c-bl, .lines .c-br { display: none; }
  }
</style>

<script>
  const portal = document.querySelector<HTMLElement>('[data-portal]')!;
  const film = portal.querySelector<HTMLVideoElement>('[data-film]')!;
  const markWide = () => portal.classList.toggle('wide', film.videoWidth > film.videoHeight);
  film.addEventListener('loadedmetadata', markWide);
  if (film.readyState >= 1) markWide();

  // The film is for computers only: on phones the still photo stands in and the film is never
  // fetched. It is attached once the screen is wide enough (also after rotating / resizing).
  const wide = matchMedia('(min-width: 761px)');
  const attach = () => {
    if (!wide.matches) { film.pause(); return; }
    if (!film.dataset.on) {
      film.dataset.on = '1';
      film.innerHTML = '<source src="/video/hero.mp4" type="video/mp4"><source src="/video/hero.webm" type="video/webm">';
      film.load();
    }
    start();
  };

  // Keep the film running. Some browsers refuse autoplay (battery saver, in-app browsers), so:
  // force the muted/inline flags in script too, retry when it can play, when the page comes
  // back, and on the visitor's first touch. A visitor who pauses it with the button stays paused.
  const btn = portal.querySelector<HTMLButtonElement>('[data-film-btn]')!;
  const label = btn.querySelector<HTMLElement>('[data-film-label]')!;
  let held = false;
  film.muted = true; film.defaultMuted = true; film.playsInline = true;
  const start = () => { if (!held && film.paused && film.dataset.on && wide.matches) film.play().catch(() => {}); };
  const sync = () => {
    btn.setAttribute('aria-pressed', String(film.paused));
    label.textContent = film.paused ? 'Phát video nền' : 'Tạm dừng video nền';
  };
  film.addEventListener('play', sync);
  film.addEventListener('pause', sync);
  film.addEventListener('canplay', start);
  attach();
  wide.addEventListener('change', attach);
  const onFirstTouch = (e: Event) => {
    if ((e.target as Element | null)?.closest?.('[data-film-btn]')) return; // the button handles itself
    start(); if (!film.paused) ['touchstart', 'pointerdown', 'scroll'].forEach((t) => window.removeEventListener(t, onFirstTouch)); };
  ['touchstart', 'pointerdown', 'scroll'].forEach((t) => window.addEventListener(t, onFirstTouch, { passive: true }));
  document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    held = !film.paused;
    if (held) film.pause(); else film.play().catch(() => {});
  });

  const enter = (e?: Event) => {
    e?.preventDefault();
    if (portal.classList.contains('leaving')) return;
    const go = () => location.assign('/trang-chu');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return go();
    portal.classList.add('leaving');
    setTimeout(go, 400);
  };
  portal.querySelector('[data-enter]')!.addEventListener('click', enter);
  window.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || e.defaultPrevented) return;
    const t = e.target as HTMLElement;
    if (t.closest('a, button, input, textarea, select')) return; // focused links handle Enter themselves
    enter(e);
  });
  // coming back with the browser's back button: show the portal again
  window.addEventListener('pageshow', (e) => { if (e.persisted) { portal.classList.remove('leaving'); start(); } });
</script>
