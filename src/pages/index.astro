</style>

<script>
  // hero leader lines: from the end of each callout's underline to its dot on the product
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  const drawLeaders = () => {
    if (!stage) return;
    const s = stage.getBoundingClientRect();
    for (const id of ['a', 'b']) {
      const line = stage.querySelector<SVGLineElement>(`[data-line="${id}"]`);
      const callout = stage.querySelector<HTMLElement>(`[data-callout="${id}"]`);
      const dot = stage.querySelector<HTMLElement>(`[data-dot="${id}"]`);
      if (!line || !callout || !dot || !callout.offsetParent) continue;
      const c = callout.getBoundingClientRect(), d = dot.getBoundingClientRect();
      // the underline end nearest the product
      const x1 = (id === 'a' ? c.left : c.right) - s.left, y1 = c.bottom - 1 - s.top;
      const x2 = d.left + d.width / 2 - s.left, y2 = d.top + d.height / 2 - s.top;
      // stop at the ring's edge
      const len = Math.hypot(x2 - x1, y2 - y1) || 1, r = d.width / 2;
      line.setAttribute('x1', String(x1)); line.setAttribute('y1', String(y1));
      line.setAttribute('x2', String(x2 - ((x2 - x1) / len) * r)); line.setAttribute('y2', String(y2 - ((y2 - y1) / len) * r));
    }
  };
  if (stage) {
    new ResizeObserver(drawLeaders).observe(stage);
    // the arch animates in; redraw once it settles
    stage.querySelector('.subject')?.addEventListener('animationend', drawLeaders);
    window.addEventListener('load', drawLeaders);
  }

  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const sync = () => { if (reduce.matches) { v.pause(); v.currentTime = 0; } };
    sync();
    reduce.addEventListener('change', () => (reduce.matches ? sync() : v.play().catch(() => {})));
    new IntersectionObserver(([e]) => {
      if (reduce.matches) return;
      e.isIntersecting ? v.play().catch(() => {}) : v.pause();
    }).observe(v);
  }
</script>
