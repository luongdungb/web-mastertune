---
import Base from '../layouts/Base.astro';
import { brands, categories } from '../lib/catalog';
import site from '../data/site.json';

// Slots follow where things go in the car. Each product lands in the slot of its category.
const slots = [
  { id: 'mid-treble', title: 'Treble & mid', where: 'Cột A, mặt taplo' },
  { id: 'loa-canh', title: 'Loa cánh', where: 'Cánh cửa trước và sau' },
  { id: 'subwoofer', title: 'Subwoofer', where: 'Cốp xe' },
  { id: 'sub-dien', title: 'Sub điện', where: 'Gầm ghế' },
  { id: 'amply', title: 'Amply', where: 'Gầm ghế hoặc cốp' },
  { id: 'dsp', title: 'Amply / DSP', where: 'Gầm ghế lái' },
  { id: 'phu-kien', title: 'Phụ kiện', where: 'Tụ điện, dây tín hiệu' },
];
const catCount = Object.fromEntries(categories.map((c) => [c.slug, c.count]));
---
<Base title="Ghép hệ thống" description="Tự ghép hệ thống âm thanh xe hơi từ thiết bị chính hãng: loa, sub, amply, DSP. Gửi cấu hình qua Zalo hoặc tải PDF để nhận báo giá từ MASTERTUNE.">
  <header class="page-head">
    <div class="wrap">
      <h1 class="display">Ghép hệ thống</h1>
      <p class="muted">Chọn thiết bị cho từng vị trí trên xe. Gửi cấu hình cho kỹ thuật viên để nhận báo giá trọn gói, gồm công lắp đặt.</p>
    </div>
  </header>

  <div class="studio builder" data-builder data-hotline={site.hotline} data-zalo-url={site.zalo}>
    <div class="wrap layout">
      <section class="slots" aria-label="Các vị trí trên xe">
        {slots.map((s) => (
          <article class="slot" data-slot={s.id} id={`vi-tri-${s.id}`}>
            <header>
              <div>
                <h2>{s.title}</h2>
                <p>{s.where}</p>
              </div>
              <button type="button" class="btn btn-outline add" data-pick={s.id} aria-label={`Chọn ${s.title}`}>Chọn</button>
            </header>
            <ul class="items" data-items aria-live="polite"></ul>
            <p class="empty" data-empty>Chưa chọn. {catCount[s.id] ?? 0} lựa chọn.</p>
          </article>
        ))}
      </section>

      <aside class="summary" aria-labelledby="sum-title">
        <h2 id="sum-title">Cấu hình của bạn</h2>
        <p class="total" data-total>0 thiết bị</p>

        <form class="customer" data-customer>
          <label>Họ tên<input name="name" autocomplete="name" /></label>
          <label>Số điện thoại<input name="phone" type="tel" autocomplete="tel" inputmode="tel" /></label>
          <label>Dòng xe<input name="car" placeholder="Ví dụ: Mazda 3 2022" /></label>
          <label>Ghi chú<textarea name="note" rows="3" placeholder="Gu nhạc, mức đầu tư dự kiến, khu vực lắp…"></textarea></label>
        </form>

        <div class="actions">
          <button type="button" class="btn btn-primary" data-zalo>Gửi qua Zalo để nhận báo giá</button>
          <button type="button" class="btn btn-light" data-print>Tải PDF cấu hình</button>
          <a class="btn btn-outline" href={`tel:${site.hotlineTel}`}>Gọi {site.hotline}</a>
        </div>
        <p class="status" role="status" data-status></p>
        <textarea class="copy-box" data-copybox readonly hidden aria-label="Nội dung cấu hình để chép"></textarea>
        <button type="button" class="clear" data-clear>Xoá cấu hình</button>
      </aside>
    </div>
  </div>

  <!-- product picker -->
  <dialog class="picker" data-picker aria-labelledby="picker-title">
    <div class="picker-head">
      <h2 id="picker-title" data-picker-title>Chọn thiết bị</h2>
      <button type="button" class="close" data-close aria-label="Đóng">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div class="picker-filters">
      <label class="sr-only" for="pk-q">Tìm theo tên</label>
      <input id="pk-q" type="search" placeholder="Tìm theo tên, mã…" data-pk-q autocomplete="off" />
      <label class="sr-only" for="pk-b">Thương hiệu</label>
      <select id="pk-b" data-pk-b>
        <option value="">Mọi thương hiệu</option>
        {brands.map((b) => <option value={b.slug}>{b.name}</option>)}
      </select>
    </div>
    <ul class="picker-list" data-pk-list></ul>
    <div class="picker-foot"><button type="button" class="btn btn-ink" data-close>Xong</button></div>
  </dialog>

  <!-- print-only quote sheet -->
  <section class="print-sheet" data-print-sheet aria-hidden="true"></section>
</Base>

<style is:global>
  .page-head { padding: var(--space-16) 0 var(--space-12); }
  .page-head h1 { font-size: var(--t-3xl); }
  .page-head p { margin-top: var(--space-4); max-width: 62ch; }

  .builder { padding-block: var(--space-12) var(--space-24); }
  .layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }

  .slots { display: grid; gap: var(--space-3); }
  .slot { background: var(--studio-card); border: 1px solid var(--studio-line); border-radius: var(--radius-m); padding: var(--space-4) var(--space-6); }
  .slot.flash { border-color: var(--signal); }
  .slot > header { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .slot h2 { font-size: var(--t-lg); font-weight: 600; }
  .slot header p { font-size: var(--t-sm); color: var(--graphite); }
  .empty { font-size: var(--t-sm); color: var(--graphite); margin-top: var(--space-2); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; }
  .items:not(:empty) { margin-top: var(--space-3); }
  .items:not(:empty) + .empty { display: none; }
  .items li {
    display: grid; grid-template-columns: 56px minmax(0, 1fr) auto auto; gap: var(--space-3); align-items: center;
    padding: var(--space-3) 0; border-top: 1px solid var(--studio-line);
  }
  .items img { width: 56px; height: 56px; object-fit: contain; }
  .items .nm { font-weight: 600; font-size: var(--t-sm); line-height: 1.3; }
  .items .nm a { color: var(--ink); text-decoration: none; }
  .items .nm a:hover { text-decoration: underline; }
  .items .br { font-size: var(--t-xs); color: var(--graphite); }
  .qty { display: inline-flex; align-items: center; border: 1px solid var(--studio-line); border-radius: var(--radius-pill); }
  .qty button { width: 36px; height: 36px; border: 0; background: transparent; cursor: pointer; font-size: 1.1rem; border-radius: 50%; }
  .qty button:hover { background: var(--studio); }
  .qty output { min-width: 1.6em; text-align: center; font-variant-numeric: tabular-nums; font-size: var(--t-sm); }
  .rm { border: 0; background: transparent; color: var(--graphite); cursor: pointer; font-size: var(--t-sm); padding: var(--space-2); text-decoration: underline; text-underline-offset: 3px; min-height: 44px; }
  .rm:hover { color: var(--ink); }

  .btn-outline { background: transparent; border-color: var(--studio-line); color: var(--ink); }
  .btn-outline:hover { border-color: var(--ink); }
  .add { min-height: 40px; }

  .summary {
    position: sticky; top: calc(var(--header-h) + var(--space-6));
    background: var(--surface); color: var(--fg); border: 1px solid var(--line); border-radius: var(--radius-l); padding: var(--space-6);
    display: grid; gap: var(--space-4);
  }
  .summary h2 { font-size: var(--t-xl); font-weight: 600; }
  .total { color: var(--fg-2); font-size: var(--t-sm); margin-top: calc(-1 * var(--space-3)); }
  .customer { display: grid; gap: var(--space-3); }
  .customer label { display: grid; gap: 6px; font-size: var(--t-sm); color: var(--fg-2); }
  .customer input, .customer textarea {
    min-height: 44px; padding: var(--space-2) var(--space-3); border-radius: var(--radius-s);
    background: var(--surface-2); border: 1px solid var(--line); color: var(--fg); font-size: var(--t-sm); resize: vertical;
  }
  .customer input:focus-visible, .customer textarea:focus-visible { outline: 2px solid var(--signal-hover); outline-offset: 1px; }
  .actions { display: grid; gap: var(--space-2); }
  .summary .btn-outline { border-color: var(--line); color: var(--fg); }
  .summary .btn-outline:hover { border-color: var(--fg-2); }
  .status { font-size: var(--t-sm); color: var(--fg-2); min-height: 1.4em; }
  .copy-box { width: 100%; min-height: 140px; background: var(--surface); color: var(--fg); border: 1px solid var(--line); border-radius: var(--radius-s); padding: var(--space-3); font-size: var(--t-xs); }
  .clear { justify-self: start; background: none; border: 0; color: var(--fg-2); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; font-size: var(--t-sm); min-height: 44px; padding: 0; }
  .clear:hover { color: var(--fg); }

  /* picker dialog */
  .picker {
    width: min(720px, calc(100vw - 2rem)); max-height: min(86vh, 900px); padding: 0;
    border: 1px solid var(--studio-line); border-radius: var(--radius-m); background: var(--studio); color: var(--ink); color-scheme: dark;
  }
  .picker[open] { display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; }
  .picker::backdrop { background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(6px); }
  .picker-head { display: flex; justify-content: space-between; align-items: center; padding: var(--space-4) var(--space-6); border-bottom: 1px solid var(--studio-line); }
  .picker-head h2 { font-size: var(--t-lg); font-weight: 600; }
  .close { width: 44px; height: 44px; border: 0; background: transparent; cursor: pointer; border-radius: 50%; display: grid; place-items: center; color: var(--ink); }
  .close:hover { background: var(--studio-card); }
  .picker-filters { display: flex; gap: var(--space-2); padding: var(--space-4) var(--space-6); }
  .picker-filters input, .picker-filters select { min-height: 44px; padding: 0 var(--space-3); border: 1px solid var(--studio-line); border-radius: var(--radius-s); background: var(--studio-card); font-size: var(--t-sm); }
  .picker-filters input { flex: 1; min-width: 0; }
  .picker-list { list-style: none; margin: 0; padding: 0 var(--space-6); overflow-y: auto; }
  .picker-list li { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: var(--space-3); align-items: center; padding: var(--space-3) 0; border-top: 1px solid var(--studio-line); }
  .picker-list img { width: 64px; height: 64px; object-fit: contain; background: var(--well); border-radius: var(--radius-s); padding: 4px; }
  .picker-list .nm { font-weight: 600; font-size: var(--t-sm); line-height: 1.3; }
  .picker-list .sub { font-size: var(--t-xs); color: var(--graphite); }
  .picker-list .pick { min-height: 40px; }
  .picker-list .pick[aria-pressed='true'] { background: var(--signal); color: var(--signal-ink); border-color: var(--signal); }
  .picker-list .none { display: block; color: var(--graphite); padding: var(--space-8) 0; border: 0; }
  .picker-foot { padding: var(--space-4) var(--space-6); border-top: 1px solid var(--studio-line); display: flex; justify-content: flex-end; }

  .print-sheet { display: none; }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .summary { position: static; }
  }
  @media (max-width: 560px) {
    .slot { padding: var(--space-4); }
    .items li { grid-template-columns: 48px minmax(0, 1fr) auto; }
    .items img { width: 48px; height: 48px; }
    .items .rm { grid-column: 2 / -1; justify-self: start; min-height: 32px; padding: 0; }
    .picker-filters { flex-direction: column; }
  }

  /* --- PDF / print: a clean one-page sheet --- */
  @media print {
    body { background: #fff !important; color: #000 !important; }
    .site-header, .site-footer, .skip-link, .page-head, .builder, .picker { display: none !important; }
    .print-sheet { display: block !important; color: #000; font-size: 11pt; }
  }
</style>

<style is:global>
  @media print {
    @page { margin: 16mm; }
    .print-sheet h1 { font-size: 18pt; font-stretch: 125%; letter-spacing: 0.08em; margin: 0 0 2pt; }
    .print-sheet .sub { color: #444; margin: 0 0 10pt; }
    .print-sheet table { width: 100%; border-collapse: collapse; margin-top: 8pt; }
    .print-sheet th, .print-sheet td { text-align: left; padding: 5pt 4pt; border-bottom: 0.5pt solid #bbb; vertical-align: top; }
    .print-sheet th { font-size: 9pt; color: #555; font-weight: 600; }
    .print-sheet .info { display: grid; grid-template-columns: 1fr 1fr; gap: 2pt 16pt; margin: 10pt 0; }
    .print-sheet .foot { margin-top: 14pt; font-size: 9pt; color: #444; }
  }
</style>

<script>
  import { getConfig, setConfig, addToConfig, removeFromConfig } from '../scripts/config-store';
  import { loadCatalog, escapeHtml as esc, fold, type ClientProduct } from '../scripts/catalog-client';

  const root = document.querySelector<HTMLElement>('[data-builder]')!;
  const SITE = { hotline: root.dataset.hotline!, zalo: root.dataset.zaloUrl! };
  const CUSTOMER_KEY = 'mt:customer';
  const slotTitle: Record<string, string> = {};
  document.querySelectorAll<HTMLElement>('[data-slot]').forEach((el) => { slotTitle[el.dataset.slot!] = el.querySelector('h2')!.textContent!; });

  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const totalEl = document.querySelector<HTMLElement>('[data-total]')!;
  const form = document.querySelector<HTMLFormElement>('[data-customer]')!;
  const copyBox = document.querySelector<HTMLTextAreaElement>('[data-copybox]')!;
  let catalog = new Map<string, ClientProduct>();

  // --- customer info persists locally so a refresh doesn't lose it
  try {
    const saved = JSON.parse(localStorage.getItem(CUSTOMER_KEY) ?? '{}');
    for (const [k, v] of Object.entries(saved)) { const el = form.elements.namedItem(k) as HTMLInputElement | null; if (el) el.value = String(v); }
  } catch {}
  form.addEventListener('input', () => localStorage.setItem(CUSTOMER_KEY, JSON.stringify(Object.fromEntries(new FormData(form)))));

  // --- render slots
  const render = () => {
    const items = getConfig().filter((i) => catalog.has(i.slug));
    const bySlot = new Map<string, typeof items>();
    for (const it of items) {
      const p = catalog.get(it.slug)!;
      const slot = document.querySelector(`[data-slot="${p.c}"]`) ? p.c : 'phu-kien';
      bySlot.set(slot, [...(bySlot.get(slot) ?? []), it]);
    }
    document.querySelectorAll<HTMLElement>('[data-slot]').forEach((el) => {
      const list = el.querySelector<HTMLElement>('[data-items]')!;
      const its = bySlot.get(el.dataset.slot!) ?? [];
      list.innerHTML = its.map((it) => {
        const p = catalog.get(it.slug)!;
        return `<li>
          <img src="${p.i}" alt="" width="56" height="56" loading="lazy">
          <div><p class="nm"><a href="/san-pham/${p.s}">${esc(p.n)}</a></p><p class="br">${esc(p.b)}</p></div>
          <div class="qty" role="group" aria-label="Số lượng ${esc(p.n)}">
            <button type="button" data-dec="${p.s}" aria-label="Bớt 1">−</button>
            <output>${it.qty}</output>
            <button type="button" data-inc="${p.s}" aria-label="Thêm 1">+</button>
          </div>
          <button type="button" class="rm" data-rm="${p.s}">Bỏ</button>
        </li>`;
      }).join('');
      el.querySelector<HTMLButtonElement>('[data-pick]')!.textContent = its.length ? 'Thêm' : 'Chọn';
    });
    const n = items.reduce((s, i) => s + i.qty, 0);
    totalEl.textContent = n ? `${n} thiết bị, ${items.length} mẫu` : 'Chưa có thiết bị nào';
    renderPicker();
  };

  document.querySelector('.slots')!.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const inc = t.closest<HTMLElement>('[data-inc]')?.dataset.inc;
    const dec = t.closest<HTMLElement>('[data-dec]')?.dataset.dec;
    const rm = t.closest<HTMLElement>('[data-rm]')?.dataset.rm;
    const pick = t.closest<HTMLElement>('[data-pick]')?.dataset.pick;
    if (inc) addToConfig(inc);
    if (dec) setConfig(getConfig().map((i) => (i.slug === dec ? { ...i, qty: i.qty - 1 } : i)));
    if (rm) removeFromConfig(rm);
    if (pick) openPicker(pick);
  });
  window.addEventListener('mt:config', render);

  // --- picker
  const picker = document.querySelector<HTMLDialogElement>('[data-picker]')!;
  const pkTitle = picker.querySelector<HTMLElement>('[data-picker-title]')!;
  const pkList = picker.querySelector<HTMLElement>('[data-pk-list]')!;
  const pkQ = picker.querySelector<HTMLInputElement>('[data-pk-q]')!;
  const pkB = picker.querySelector<HTMLSelectElement>('[data-pk-b]')!;
  let pkSlot = '';
  let opener: HTMLElement | null = null;

  function renderPicker() {
    if (!picker.open) return;
    const chosen = new Map(getConfig().map((i) => [i.slug, i.qty]));
    const q = fold(pkQ.value.trim());
    const list = [...catalog.values()].filter((p) => p.c === pkSlot && (!pkB.value || p.bs === pkB.value) && (!q || q.split(/\s+/).every((w) => fold(`${p.n} ${p.b}`).includes(w))));
    pkList.innerHTML = list.length ? list.map((p) => {
      const qty = chosen.get(p.s) ?? 0;
      const spec = p.k.map(([k, v]) => `${esc(k)}: ${esc(v)}`).join(', ');
      return `<li>
        <img src="${p.i}" alt="" width="64" height="64" loading="lazy">
        <div><p class="nm">${esc(p.n)}</p><p class="sub">${esc(p.b)}${spec ? `. ${spec}` : ''}</p></div>
        <button type="button" class="btn btn-outline pick" data-add="${p.s}" aria-pressed="${qty > 0}">${qty > 0 ? `Đã chọn ${qty}` : 'Thêm'}</button>
      </li>`;
    }).join('') : '<li class="none">Không có thiết bị khớp. Thử bỏ bớt bộ lọc.</li>';
  }
  function openPicker(slot: string) {
    pkSlot = slot;
    opener = document.activeElement as HTMLElement;
    pkTitle.textContent = `Chọn ${slotTitle[slot] ?? 'thiết bị'}`;
    pkQ.value = ''; pkB.value = '';
    picker.showModal();
    renderPicker();
    pkQ.focus();
  }
  pkList.addEventListener('click', (e) => {
    const s = (e.target as HTMLElement).closest<HTMLElement>('[data-add]')?.dataset.add;
    if (s) addToConfig(s);
  });
  pkQ.addEventListener('input', renderPicker);
  pkB.addEventListener('change', renderPicker);
  picker.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => picker.close()));
  picker.addEventListener('click', (e) => { if (e.target === picker) picker.close(); }); // click on backdrop
  picker.addEventListener('close', () => {
    opener?.focus();
    const slotEl = document.querySelector(`[data-slot="${pkSlot}"]`);
    slotEl?.classList.add('flash');
    setTimeout(() => slotEl?.classList.remove('flash'), 900);
  });

  // --- summary text (Zalo + PDF)
  const customer = () => Object.fromEntries(new FormData(form)) as Record<string, string>;
  const summaryText = () => {
    const c = customer();
    const lines = ['Yêu cầu báo giá cấu hình âm thanh MASTERTUNE', ''];
    if (c.name) lines.push(`Họ tên: ${c.name}`);
    if (c.phone) lines.push(`SĐT: ${c.phone}`);
    if (c.car) lines.push(`Dòng xe: ${c.car}`);
    lines.push('');
    for (const it of getConfig()) {
      const p = catalog.get(it.slug);
      if (p) lines.push(`- ${p.n} (${p.b}) x${it.qty}`);
    }
    if (c.note) lines.push('', `Ghi chú: ${c.note}`);
    return lines.join('\n');
  };
  const needItems = () => {
    if (getConfig().length) return true;
    status.textContent = 'Hãy chọn ít nhất một thiết bị trước.';
    return false;
  };

  document.querySelector('[data-zalo]')!.addEventListener('click', async () => {
    if (!needItems()) return;
    const text = summaryText();
    copyBox.hidden = true;
    try {
      await navigator.clipboard.writeText(text);
      status.textContent = 'Đã chép cấu hình. Zalo đang mở: dán (Ctrl+V hoặc giữ để dán) vào khung chat rồi gửi.';
    } catch {
      copyBox.value = text; copyBox.hidden = false; copyBox.select();
      status.textContent = 'Chép nội dung bên dưới, rồi dán vào khung chat Zalo vừa mở.';
    }
    window.open(SITE.zalo, '_blank', 'noopener');
  });

  document.querySelector('[data-print]')!.addEventListener('click', () => {
    if (!needItems()) return;
    const c = customer();
    const date = new Date().toLocaleDateString('vi-VN');
    const rows = getConfig().map((it, i) => {
      const p = catalog.get(it.slug);
      return p ? `<tr><td>${i + 1}</td><td>${esc(p.n)}</td><td>${esc(p.b)}</td><td>${esc(p.cl)}</td><td>${it.qty}</td></tr>` : '';
    }).join('');
    document.querySelector<HTMLElement>('[data-print-sheet]')!.innerHTML = `
      <h1>MASTERTUNE</h1>
      <p class="sub">Cấu hình âm thanh đề xuất, ngày ${date}. Giá sẽ được báo riêng theo xe và công lắp đặt.</p>
      <div class="info">
        <div>Họ tên: ${esc(c.name || '…')}</div><div>Số điện thoại: ${esc(c.phone || '…')}</div>
        <div>Dòng xe: ${esc(c.car || '…')}</div><div>Ghi chú: ${esc(c.note || '')}</div>
      </div>
      <table><thead><tr><th>#</th><th>Thiết bị</th><th>Thương hiệu</th><th>Hạng mục</th><th>SL</th></tr></thead><tbody>${rows}</tbody></table>
      <p class="foot">Gửi file này qua Zalo ${SITE.zalo.replace('https://', '')} hoặc gọi ${SITE.hotline} để nhận báo giá. Thiết bị chính hãng, bảo hành theo chính sách từng thương hiệu.</p>`;
    status.textContent = 'Trong hộp thoại in, chọn "Lưu dưới dạng PDF".';
    window.print();
  });

  document.querySelector('[data-clear]')!.addEventListener('click', () => {
    if (!getConfig().length) return;
    if (confirm('Xoá toàn bộ thiết bị trong cấu hình?')) { setConfig([]); status.textContent = 'Đã xoá cấu hình.'; }
  });

  // --- boot
  loadCatalog().then((map) => {
    catalog = map;
    render();
    // deep link from the home page car: /ghep-he-thong?vi-tri=amply
    const slot = new URLSearchParams(location.search).get('vi-tri');
    if (slot && document.querySelector(`[data-slot="${CSS.escape(slot)}"]`)) {
      document.getElementById(`vi-tri-${slot}`)?.scrollIntoView({ block: 'center' });
      openPicker(slot);
    }
  }).catch(() => { status.textContent = 'Không tải được danh mục. Hãy tải lại trang.'; });
</script>
