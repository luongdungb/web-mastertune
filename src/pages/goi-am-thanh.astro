---
import Base from '../layouts/Base.astro';
import packages from '../data/packages.json';
import { products, brandOf } from '../lib/catalog';
const bySlug = new Map(products.map((p) => [p.slug, p]));
---
<Base title="Gói âm thanh" description="Các gói âm thanh xe hơi dựng sẵn từ thiết bị chính hãng: nâng cấp loa zin, sân khấu trước mặt, hi-end 3-way, cấu hình thi đấu. Báo giá theo xe.">
  <header class="page-head">
    <div class="wrap">
      <h1 class="display">Gói âm thanh</h1>
      <p class="muted">Cấu hình đã được kỹ thuật viên phối sẵn, từ nâng cấp loa zin tới cấu hình thi đấu. Mỗi gói có thể đổi thiết bị trong trình ghép hệ thống.</p>
      <a class="quiz-link" href="/tim-he-thong">Chưa chắc gói nào hợp? Trả lời 4 câu hỏi</a>
    </div>
  </header>

  <section class="studio list" aria-label="Danh sách gói">
    <ol class="wrap packages">
      {packages.map((pk) => (
        <li class="pkg" id={pk.slug}>
          <header>
            <p class="tier">{pk.tier}</p>
            <h2>{pk.name}</h2>
            <p class="for">{pk.for}</p>
          </header>
          <ul class="items">
            {pk.items.map((it) => {
              const p = bySlug.get(it.slug)!;
              return (
                <li>
                  <img src={p.image} alt="" width="64" height="64" loading="lazy" />
                  <div>
                    <p class="role">{it.role}</p>
                    <a href={`/san-pham/${p.slug}`}>{p.name}</a>
                    <p class="brand">{brandOf(p).name}{it.qty > 1 ? `, ${it.qty} bộ` : ''}</p>
                  </div>
                </li>
              );
            })}
          </ul>
          <div class="acts">
            <button type="button" class="btn btn-ink" data-add-pkg={JSON.stringify(pk.items.map(({ slug, qty }) => ({ slug, qty })))}>Đưa gói vào cấu hình</button>
            <p class="note" role="status"></p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .page-head { padding: var(--space-16) 0 var(--space-12); }
  .page-head h1 { font-size: var(--t-3xl); }
  .page-head p { margin-top: var(--space-4); max-width: 62ch; }
  .quiz-link { display: inline-block; margin-top: var(--space-6); color: var(--fg); font-weight: 600; text-underline-offset: 5px; text-decoration-color: var(--signal); }
  .list { padding-block: var(--space-12) var(--space-24); }
  .packages { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .pkg {
    background: var(--studio-card); border: 1px solid var(--studio-line); border-radius: var(--radius-m);
    padding: var(--space-8); display: grid; gap: var(--space-6); align-content: start; scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .pkg:target { border-color: var(--signal); }
  .tier { font-size: var(--t-sm); color: var(--signal); font-weight: 600; }
  .pkg h2 { font-size: var(--t-2xl); font-weight: 600; margin-top: var(--space-1); }
  .for { color: var(--graphite); margin-top: var(--space-3); line-height: 1.55; }
  .items { list-style: none; margin: 0; padding: 0; display: grid; }
  .items li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: var(--space-4); align-items: center; padding: var(--space-3) 0; border-top: 1px solid var(--studio-line); }
  .items img { width: 64px; height: 64px; object-fit: contain; background: var(--well); border-radius: var(--radius-s); padding: 4px; }
  .role { font-size: var(--t-xs); color: var(--graphite); }
  .items a { color: var(--ink); font-weight: 600; font-size: var(--t-sm); text-decoration: none; line-height: 1.3; }
  .items a:hover { text-decoration: underline; }
  .brand { font-size: var(--t-xs); color: var(--graphite); }
  .acts { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .note { font-size: var(--t-sm); color: var(--graphite); }
  .note a { color: var(--signal); font-weight: 600; }
  @media (max-width: 860px) { .packages { grid-template-columns: 1fr; } .pkg { padding: var(--space-6); } }
</style>

<script>
  import { getConfig, setConfig } from '../scripts/config-store';
  document.querySelectorAll<HTMLButtonElement>('[data-add-pkg]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const items = JSON.parse(btn.dataset.addPkg!) as { slug: string; qty: number }[];
      const cfg = getConfig();
      for (const it of items) {
        const f = cfg.find((c) => c.slug === it.slug);
        if (f) f.qty += it.qty; else cfg.push({ ...it });
      }
      setConfig(cfg);
      const note = btn.parentElement!.querySelector('.note')!;
      note.innerHTML = 'Đã đưa vào cấu hình. <a href="/ghep-he-thong">Xem và chỉnh</a>';
    });
  });
</script>
