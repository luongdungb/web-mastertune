---
import Base from '../layouts/Base.astro';
import CarSound3D from '../components/CarSound3D.astro';
import Spotlight from '../components/Spotlight.astro';
import products from '../data/products.json';
import brands from '../data/brands.json';
import categories from '../data/categories.json';
import site from '../data/site.json';

const bySlug = (s: string) => products.find((p) => p.slug === s)!;
const featured = [
  'amply-dsp-12-kenh-resolut-x12-dsp',
  'abyss-6-5h-2way-component-speaker',
  'loa-sub-hoi-dong-thung-steg-st10p-pro',
  'loa-canh-phan-tan-2-way-audiocircle-ml-c6-2',
].map(bySlug).filter(Boolean);
const brandName = Object.fromEntries(brands.map((b) => [b.slug, b.name]));

const catCover: Record<string, string> = {
  'loa-canh': 'loa-canh-phan-tan-2-way-audiocircle-ml-c6-2',
  'mid-treble': 'loa-mid-treble-steg-sff3',
  subwoofer: 'loa-sub-hoi-audiocircle-ml-s10',
  'sub-dien': 'loa-sub-dien-dls-acw10i',
  amply: 'amply-mono-dls-cci500',
  dsp: 'amply-dsp-12-kenh-resolut-x12-dsp',
};
const shownCats = categories.filter((c) => catCover[c.slug]);
const totalProducts = products.length;
---
<Base title="Trang chủ">
  <Spotlight headingLevel="h1" />

  <!-- BRANDS -->
  <section class="brands" aria-label="Thương hiệu phân phối">
    <ul class="wrap brand-row">
      {brands.filter((b) => b.logo).map((b) => (
        <li><a href={`/thuong-hieu/${b.slug}`} title={b.name}><img src={b.logo!} alt={b.name} width="160" height="54" loading="lazy" /></a></li>
      ))}
    </ul>
  </section>

  <CarSound3D />

  <!-- CATEGORIES (studio) -->
  <section class="studio section" aria-labelledby="cat-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="cat-title" class="display">Thiết bị</h2>
      </div>
      <ul class="cat-grid">
        {shownCats.map((c) => {
          const cover = bySlug(catCover[c.slug]);
          return (
            <li>
              <a class="cat-card" href={`/san-pham?loai=${c.slug}`}>
                <img src={cover?.image} alt="" width="320" height="240" loading="lazy" decoding="async" />
                <div class="cat-meta">
                  <h3>{c.label}</h3>
                  <span class="count">{c.count}</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>

      <div class="featured">
        <h2 class="featured-title">Được chọn nhiều</h2>
        <ul class="prod-grid">
          {featured.map((p) => (
            <li>
              <a class="prod-card" href={`/san-pham/${p.slug}`}>
                <div class="prod-img"><img src={p.image} alt={p.name} width="400" height="400" loading="lazy" decoding="async" /></div>
                <p class="prod-brand">{brandName[p.brand]}</p>
                <h3>{p.name}</h3>
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn-ink" href="/san-pham">Xem toàn bộ {totalProducts} sản phẩm</a>
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="section tools" aria-labelledby="tools-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="tools-title" class="display">Bắt đầu cấu hình</h2>
      </div>
      <ol class="tool-list">
        <li>
          <a href="/tim-he-thong">
            <h3>Trả lời 4 câu hỏi</h3>
            <p class="muted">Nhận gợi ý cấu hình trong một phút.</p>
          </a>
        </li>
        <li>
          <a href="/ghep-he-thong">
            <h3>Tự ghép hệ thống</h3>
            <p class="muted">Chọn từng thiết bị, gửi để nhận báo giá.</p>
          </a>
        </li>
        <li>
          <a href="/cau-hinh-theo-xe">
            <h3>Theo dòng xe</h3>
            <p class="muted">Cấu hình gợi ý và xe cùng dòng đã lắp.</p>
          </a>
        </li>
        <li>
          <a href="/goi-am-thanh">
            <h3>Chọn gói dựng sẵn</h3>
            <p class="muted">Cấu hình đã được kỹ thuật viên phối sẵn.</p>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- SHOWCASE -->
  <section class="section showcase" aria-labelledby="show-title">
    <div class="wrap show-grid">
      <figure class="show-main">
        <img src="/images/s/news-emma-2025.webp" alt="Đội ngũ MASTERTUNE và các đại lý nâng cúp tại giải thi đấu âm thanh xe hơi EMMA Việt Nam 2025" width="1000" height="666" loading="lazy" decoding="async" />
      </figure>
      <div class="show-text">
        <h2 id="show-title" class="display">Kiểm chứng trên sân khấu thi đấu</h2>
        <p class="muted">EMMA Việt Nam 2025.</p>
        <div class="hero-cta">
          <a class="btn btn-light" href="/showcase">Xem showcase</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DEALERS -->
  <section class="studio section dealers" aria-labelledby="dealer-title">
    <div class="wrap dealer-grid">
      <div>
        <h2 id="dealer-title" class="display">Đại lý chính hãng</h2>
      </div>
      <div class="dealer-actions">
        <a class="dealer-card" href="/dai-ly"><h3>Tìm đại lý gần bạn</h3></a>
        <a class="dealer-card" href="/dai-ly#kiem-tra"><h3>Kiểm tra đại lý</h3></a>
        <a class="dealer-card" href="/bao-hanh"><h3>Tra cứu bảo hành</h3></a>
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="final" aria-labelledby="final-title">
    <div class="final-card">
      <div class="final-inner">
        <p class="eyebrow">Tư vấn miễn phí</p>
        <h2 id="final-title" class="display">Nói chuyện với kỹ thuật viên</h2>
        <div class="hero-cta">
          <a class="btn btn-primary" href={site.zalo} target="_blank" rel="noopener">Nhắn Zalo</a>
          <a class="btn btn-ghost" href={`tel:${site.hotlineTel}`}>Gọi {site.hotline}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* BRANDS */
  .brands { border-top: 1px solid var(--line); }
  .brand-row { list-style: none; margin: 0 auto; padding: var(--space-8) 0; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-8); }
  .brand-row a { display: block; padding: var(--space-2); }
  .brand-row img { height: 40px; width: auto; max-width: 140px; object-fit: contain; filter: brightness(0) invert(1); opacity: 0.5; transition: opacity 200ms; }
  .brand-row a:hover img { opacity: 0.9; }

  /* STUDIO: categories + featured */
  .split { grid-template-columns: 1fr 1fr; align-items: end; }
  .split h2 { max-width: 14ch; }
  .split p { font-size: var(--t-base); max-width: 44ch; justify-self: end; }
  .cat-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .cat-card {
    display: grid; grid-template-columns: 132px 1fr; gap: var(--space-4); align-items: center;
    background: var(--studio-card); border: 1px solid var(--studio-line); border-radius: var(--radius-m);
    padding: var(--space-4); text-decoration: none; height: 100%;
    transition: border-color 180ms;
  }
  .cat-card:hover { border-color: var(--ink); }
  .cat-card img { width: 132px; height: 112px; object-fit: contain; background: var(--well); border-radius: var(--radius-s); padding: 8px; mix-blend-mode: normal; }
  .cat-meta { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
  .cat-meta h3 { font-size: var(--t-lg); font-weight: 600; }
    .count { font-size: var(--t-sm); color: var(--graphite); font-variant-numeric: tabular-nums; }

  .featured { margin-top: var(--space-24); display: grid; gap: var(--space-8); justify-items: start; }
  .featured-title { font-size: var(--t-xl); font-weight: 600; }
  .prod-grid { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .prod-card { display: grid; gap: var(--space-2); text-decoration: none; }
  .prod-img { background: var(--well); border-radius: var(--radius-m); aspect-ratio: 1; display: grid; place-items: center; padding: var(--space-6); border: 1px solid var(--studio-line); transition: border-color 180ms; }
  .prod-card:hover .prod-img { border-color: var(--ink); }
  .prod-img img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .prod-brand { font-size: var(--t-xs); color: var(--graphite); font-weight: 600; margin-top: var(--space-2); }
  .prod-card h3 { font-size: var(--t-base); font-weight: 600; line-height: 1.3; }
  .prod-specs { margin: var(--space-1) 0 0; display: grid; gap: 2px; font-size: var(--t-xs); }
  .prod-specs div { display: flex; justify-content: space-between; gap: var(--space-3); border-top: 1px solid var(--studio-line); padding-top: 4px; }
  .prod-specs dt { color: var(--graphite); }
  .prod-specs dd { margin: 0; text-align: right; font-weight: 500; }

  /* TOOLS — a real sequence: quiz -> build -> packages */
  .tool-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); counter-reset: tool; }
  .tool-list li { counter-increment: tool; }
  .tool-list a {
    display: grid; gap: var(--space-3); padding: var(--space-6); text-decoration: none; height: 100%; align-content: start;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-m);
    transition: border-color 220ms var(--ease-out), transform 220ms var(--ease-out);
  }
  .tool-list a::before {
    content: '[' counter(tool, decimal-leading-zero) ']'; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em;
    color: var(--signal); margin-bottom: var(--space-6);
  }
  .tool-list a:hover { border-color: #3a3e45; transform: translateY(-2px); }
  .tool-list h3 { font-size: var(--t-xl); font-weight: 600; }
  .tool-list p { line-height: 1.55; font-size: var(--t-sm); }

  /* SHOWCASE */
  .showcase { border-top: 1px solid var(--line); }
  .show-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .show-main { margin: 0; border-radius: var(--radius-m); overflow: hidden; }
  .show-main img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .show-text { display: grid; gap: var(--space-6); }
  .show-text h2 { font-size: var(--t-2xl); }

  /* DEALERS */
  .dealer-grid { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  .dealer-grid h2 { font-size: var(--t-2xl); }
  .dealer-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .dealer-card {
    display: flex; align-items: flex-end; min-height: 120px;
    padding: var(--space-6); border-radius: var(--radius-m); background: var(--studio-card);
    border: 1px solid var(--studio-line); text-decoration: none; transition: border-color 180ms;
  }
  .dealer-card:hover { border-color: var(--ink); }
  .dealer-card h3 { font-size: var(--t-lg); font-weight: 600; }

  /* FINAL */
  .final { padding: var(--space-8) var(--frame) 0; }
  .final-card {
    position: relative; overflow: hidden; border-radius: var(--radius-l); color: var(--fg); border: 1px solid var(--line);
    padding: clamp(4rem, 9vw, 8rem) var(--gutter);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 100% 25%,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 12.5% 100%,
      var(--surface);
  }
  .final-card::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(45% 80% at 50% 100%, rgba(201, 206, 214, 0.12), rgba(201, 206, 214, 0) 70%);
  }
  .final-inner { position: relative; display: grid; gap: var(--space-6); justify-items: center; text-align: center; }
  
  .final-inner h2 { font-size: clamp(2.5rem, 1rem + 5vw, 5.5rem); font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; line-height: 0.95; max-width: 14ch; }

  @media (max-width: 1080px) {
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
    .prod-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .split, .show-grid, .dealer-grid { grid-template-columns: 1fr; }
    .split p { justify-self: start; }
    .tool-list { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .cat-grid { grid-template-columns: 1fr; }
    .dealer-actions { grid-template-columns: 1fr; }
    .tool-list { grid-template-columns: 1fr; }
    .dealer-card { min-height: 0; }
    .cat-card { grid-template-columns: 96px 1fr; }
    .cat-card img { width: 96px; height: 88px; }
    .prod-grid { gap: var(--space-4); }
  }
</style>
