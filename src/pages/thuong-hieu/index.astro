---
import Base from '../../layouts/Base.astro';
import { brands, products, categories } from '../../lib/catalog';
const catLabel = new Map(categories.map((c) => [c.slug, c.label]));
const lines = (slug: string) => {
  const counts = new Map<string, number>();
  for (const p of products) if (p.brand === slug) counts.set(p.category, (counts.get(p.category) ?? 0) + 1);
  return [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([c]) => catLabel.get(c)).filter(Boolean).slice(0, 3).join(', ');
};
---
<Base title="Thương hiệu" description={`${brands.length} thương hiệu âm thanh xe hơi do MASTERTUNE phân phối chính hãng tại Việt Nam.`}>
  <header class="page-head">
    <div class="wrap">
      <h1 class="display">Thương hiệu</h1>
      <p class="muted">{brands.length} thương hiệu âm thanh xe hơi, phân phối chính hãng tại Việt Nam.</p>
    </div>
  </header>
  <section class="studio list" aria-label="Danh sách thương hiệu">
    <ul class="wrap grid">
      {brands.map((b) => (
        <li>
          <a href={`/thuong-hieu/${b.slug}`} class="brand-card">
            <div class="logo">
              {b.logo ? <img src={b.logo} alt={b.name} width="240" height="80" loading="lazy" /> : <span class="wordmark">{b.name}</span>}
            </div>
            <div class="meta">
              <h2>{b.name}</h2>
              <p>{b.count} sản phẩm{b.origin ? `, ${b.origin}` : ''}</p>
              <p class="lines">{lines(b.slug)}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page-head { padding: var(--space-16) 0 var(--space-12); }
  .page-head h1 { font-size: var(--t-3xl); }
  .page-head p { margin-top: var(--space-4); }
  .list { padding-block: var(--space-12) var(--space-24); }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-4); }
  .brand-card {
    display: grid; gap: var(--space-4); padding: var(--space-6); height: 100%;
    background: var(--studio-card); border: 1px solid var(--studio-line); border-radius: var(--radius-m);
    text-decoration: none; color: var(--ink); transition: border-color 180ms;
  }
  .brand-card:hover { border-color: var(--ink); }
  .logo { height: 72px; display: flex; align-items: center; }
  .logo img { max-height: 56px; width: auto; max-width: 200px; object-fit: contain; }
  .wordmark { font-size: var(--t-xl); font-stretch: 125%; font-weight: 700; }
  .meta h2 { font-size: var(--t-lg); font-weight: 600; }
  .meta p { font-size: var(--t-sm); color: var(--graphite); }
  .lines { margin-top: var(--space-1); }
</style>
