# Copy thành .env (máy cá nhân) hoặc khai báo trong phần Environment variables của Hostinger.
# Mã truy cập chung cho khu đại lý (đổi mã = mọi đại lý phải nhập lại)
DEALER_ACCESS_CODE=
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# (tuỳ chọn) đường dẫn file bảo hành, mặc định private/warranty.csv
WARRANTY_FILE=
